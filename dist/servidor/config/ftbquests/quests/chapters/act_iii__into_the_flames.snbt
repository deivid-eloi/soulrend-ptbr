	quests: [
		{
			dependencies: ["0EC6D498A3663E19"]
			description: [
				"Você venceu os desafios da Superfície e ficou mais forte a cada batalha."
				""
				"Mas além da segurança das terras conhecidas há um reino sem piedade. Rios de lava, fortalezas antigas e seres monstruosos esperam os corajosos o bastante para entrar."
				""
				"O Nether não é lugar para os fracos. Dê um passo à frente e enfrente as chamas."
				""
				"&lTalvez seja hora de reforjar seu arsenal."
			]
			hide_until_deps_complete: true
