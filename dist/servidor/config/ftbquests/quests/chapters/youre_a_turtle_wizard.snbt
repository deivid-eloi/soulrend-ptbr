	order_index: 0
	quest_links: [ ]
	quests: [
		{
			dependencies: ["1A83047D85E293CD"]
			description: ["A magia é muito importante para um mago e continua muito útil para quem só se arrisca nela. Ela é ótima para causar dano ou para feitiços utilitários, como teletransporte. Há muitas escolas de magia para aprender, como &6Fogo&f&r, &bGelo&f&r, &eRaio&f&r, &2Veneno&f&r, &5Ender&f&r, &7Evocação&f&r, &fSagrada, &4Sangue&f&r, &2Geomancia&r, &3Água&r e uma escola especial chamada &0Ancestral&f&r."]
			hide_until_deps_complete: true
			id: "6AD127305440E2A9"
			subtitle: "De Volta à Escola"
			tasks: [{
