      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "scale set pehkui:height 1.2777777777777777 @s"
        },
        {
          "type": "origins:execute_command",
          "command": "scale set pehkui:model_height 1 @s"
        }
      ]
    }
  }
